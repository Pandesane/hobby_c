{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Meson Project",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/builddebug/hobby_c", // Path to the binary
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "miDebuggerPath": "/usr/bin/gdb", // Ensure this path is correct for your system
      "preLaunchTask": "meson compile -C builddebug" // Optional: run a build task before debugging
    }
  ]
}
